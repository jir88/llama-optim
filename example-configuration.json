{
  "model_path": "path/to/model.gguf",
  "server_path": "path/to/llama-server.exe",
  "server_port": 8067,

  "static_params": {
    "threads": 6,
    "flash_attn": "on"
  },

  "optimize": {
    "ubatch_size": [512, 1024, 2048, 4096],
    "fit_ctx": [2048, 4096],
    "gpu_layers": {
        "type": "integer",
        "low": 0,
        "high": 10,
        "step": 1
    },
    "backend_sampling": {
        "type": "flag"
    },
    "batch_size": {
        "type": "multiple",
        "multiple_type": "integer",
        "reference": "ubatch_size",
        "low": 1,
        "high": 8,
        "step": 1
    }
  },

  "benchmark": {
    "prompt_type": "string",
    "prompt": "Hello, how are you today?",
    "tokens": 128,
    "warmup_seconds": 2,
    "measure_seconds": 5,
    "optimize": "generation"
  },

  "search": {
    "strategy": "brute",
    "random_trials": 10,
    "bayes_trials": 30,
    "bayes_beta": 0.3,  
    "n_trials": 100,
    "allowed_reps": 2
  }
}
